# Example sandbox for the weather suite.
#
# Extends the pi community sandbox with the weather agent: its system prompt,
# an OpenAI-compatible model provider, and the MCP server it calls its weather
# tools on. Nothing of MiDojo is in the image: the suite runs in host mode,
# where MiDojo's interception layer runs on the host and the agent's MCP
# server is the interceptor MiDojo gives it (MIDOJO_TOOL_URL and
# MIDOJO_TOOL_TOKEN). Replace this with your own production sandbox image —
# the suite.yaml eval does not change.
#
# Build (from repo root):
#   podman build --pull=always --platform linux/arm64 \
#     -t localhost/weather-pi:latest -f suites/weather/sandbox_pi/Containerfile .
#
# No model is baked in. The suite passes the model server, model and API key
# (LITELLM_API_URL, LITELLM_MODEL, LITELLM_API_KEY) into the sandbox at run
# time, and start-agent.sh points PI at them, so one image works with any
# OpenAI-compatible model server.

FROM ghcr.io/nvidia/openshell-community/sandboxes/pi:latest

USER root

# PI 1.0, newer than the PI in the community image.
RUN npm install -g @earendil-works/pi-coding-agent@1.0.0

# Install into pi's global agent dir (~/.pi/agent = /sandbox/.pi/agent), which
# pi reads regardless of the process working directory. midojo runs the agent
# in /sandbox/workdir, so a project-local .pi/ would not be found, and a file
# written there would show up in the evaluation's workdir observation.
RUN mkdir -p /sandbox/.pi/agent
# mcp.json names the agent's weather tools server, with @MIDOJO_TOOL_URL@ and
# @MIDOJO_TOOL_TOKEN@ placeholders; models.json and settings.json keep
# @LITELLM_API_URL@ and @LITELLM_MODEL@ ones. start-agent.sh fills them in.
COPY suites/weather/sandbox_pi/models.json suites/weather/sandbox_pi/settings.json \
     suites/weather/sandbox_pi/AGENTS.md suites/weather/sandbox_pi/mcp.json /sandbox/.pi/agent/
COPY suites/weather/sandbox_pi/start-agent.sh /sandbox/midojo/

RUN chown -R sandbox:sandbox /sandbox/.pi /sandbox/midojo

USER sandbox
