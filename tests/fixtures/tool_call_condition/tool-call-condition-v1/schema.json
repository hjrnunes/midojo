{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tool-call-condition-v1",
  "description": "A condition over the tool calls a target emitted. Mirrors the structural rules of validate_condition; the README states what only the vectors check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparisons"
  ],
  "properties": {
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparison"
      }
    }
  },
  "$defs": {
    "comparison": {
      "oneOf": [
        {
          "$ref": "#/$defs/valueComparison"
        },
        {
          "$ref": "#/$defs/notCalledComparison"
        },
        {
          "$ref": "#/$defs/orderComparison"
        }
      ]
    },
    "valueComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "left",
        "op",
        "right"
      ],
      "properties": {
        "kind": {
          "const": "value"
        },
        "left": {
          "$ref": "#/$defs/operand"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le",
            "in",
            "not_in"
          ]
        },
        "right": {
          "$ref": "#/$defs/operand"
        }
      },
      "anyOf": [
        {
          "properties": {
            "left": {
              "$ref": "#/$defs/argumentOperand"
            }
          }
        },
        {
          "properties": {
            "right": {
              "$ref": "#/$defs/argumentOperand"
            }
          }
        }
      ]
    },
    "notCalledComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "not_called"
        },
        "operation": {
          "type": "string"
        },
        "where": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "argument",
              "value"
            ],
            "properties": {
              "argument": {
                "type": "string"
              },
              "value": {}
            }
          }
        }
      }
    },
    "orderComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "requires_prior"
      ],
      "properties": {
        "kind": {
          "const": "order"
        },
        "operation": {
          "type": "string"
        },
        "requires_prior": {
          "type": "string"
        },
        "same_argument": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "operand": {
      "oneOf": [
        {
          "$ref": "#/$defs/argumentOperand"
        },
        {
          "$ref": "#/$defs/literalOperand"
        }
      ]
    },
    "argumentOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "operation",
        "argument"
      ],
      "properties": {
        "source": {
          "const": "argument"
        },
        "operation": {
          "type": "string"
        },
        "argument": {
          "type": "string"
        }
      }
    },
    "literalOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "value"
      ],
      "properties": {
        "source": {
          "const": "literal"
        },
        "value": {}
      }
    }
  }
}
